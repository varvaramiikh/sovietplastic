{
  "name": "karbolit-sovetsky-plastik",
  "private": true,
  "version": "1.0.0",
  "description": "Сайт «Советский пластик» (КарболитЪ): перенос из Claude Design на React + TypeScript + Vite",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "compare": "node scripts/compare_with_original.mjs",
    "server": "node --env-file=wserver/.env wserver/server.mjs",
    "test:auth": "node --test wserver/auth.test.mjs",
    "test:components": "node scripts/check-components.mjs"
  },
  "dependencies": {
    "@fontsource/onest": "^5.3.1",
    "nodemailer": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "acorn": "^8.19.0",
    "parse5": "^7.3.0",
    "prettier": "^3.10.1",
    "typescript": "5.7",
    "vite": "^6.4.6"
  }
}
